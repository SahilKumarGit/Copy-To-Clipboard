{
  "name": "copy-to-clipboard",
  "version": "1.0.9",
  "description": "Cross-platform lightweight clipboard manager for Ubuntu Linux and macOS",
  "main": "src/main.js",
  "scripts": {
    "start": "electron src/main.js",
    "test": "node tests/storage.test.js",
    "build:mac": "bash scripts/build-mac.sh",
    "build:ubuntu": "bash scripts/build-ubuntu.sh"
  },
  "build": {
    "appId": "com.clipboard.manager",
    "productName": "ClipboardManager",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "bin/**/*",
      "src/**/*",
      "ui/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSAppSleepDisabled": true
      },
      "target": [
        "dmg",
        "tar.xz"
      ],
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "target": [
        "tar.xz",
        "deb"
      ],
      "maintainer": "Sahil Kumar Sahoo <email.sahil@yahoo.com>",
      "artifactName": "${productName}-${version}-${arch}-linux.${ext}",
      "executableName": "clipboard-manager",
      "desktop": {
        "StartupWMClass": "ClipboardManager"
      }
    },
    "deb": {
      "depends": [
        "xdotool",
        "libnotify4",
        "libxtst6"
      ]
    },
    "desktopName": "clipboard-manager.desktop",
    "electronLanguages": [
      "en",
      "en_GB",
      "en-GB",
      "en-US"
    ]
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "ubuntu",
    "macos"
  ],
  "author": {
    "name": "Sahil Kumar Sahoo",
    "email": "email.sahil@yahoo.com"
  },
  "license": "MIT"
}
